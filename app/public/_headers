# Security headers — applied to every response. Blocks clickjacking
# (frame embedding), MIME-sniffing, and referrer leakage, and denies unused
# powerful features. NOTE: microphone stays allowed (self) because voice input
# and the recitation feature use the Web Speech API.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), microphone=(self)

# Always revalidate the app shell and service worker so a new deploy is
# detected on the very next visit (no stale cached version).
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets are content-addressed (filename changes when content
# changes), so they are safe to cache hard for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — a given file's content never changes. Cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The welcome video + poster are large-ish and change rarely. Cache 30 days so
# returning visitors don't re-download (~3.6 MB) every session. Not "immutable"
# because the filename is stable — the window still revalidates eventually, so a
# future swap propagates without a forced cache-bust.
/welcome.mp4
  Cache-Control: public, max-age=2592000
/welcome-poster.jpg
  Cache-Control: public, max-age=2592000
/welcome-en.mp4
  Cache-Control: public, max-age=2592000
/welcome-en-poster.jpg
  Cache-Control: public, max-age=2592000
