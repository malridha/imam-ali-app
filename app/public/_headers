# Always revalidate the app shell and service worker so a new deploy is
# detected on the very next visit (no stale cached version).
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets are content-addressed (filename changes when content
# changes), so they are safe to cache hard for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
