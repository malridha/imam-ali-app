# Source library — never commit large binaries or extracted output to git.
# These files are upstream material, regenerable, and often have
# unclear redistribution rights.

# Original sources
*.pdf
*.epub
*.zip
*.mobi

# Extracted text (regenerated by convert.py)
extracted/

# Python cruft
__pycache__/
*.pyc
.venv/

# But DO keep:
!README.md
!convert.py
!.gitignore
