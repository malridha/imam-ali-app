*.pages

# Local Claude Code tooling state (machine-specific; may hold cached commands/keys)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Vercel
.vercel

# Big source files
sources/*.pdf
sources/*.epub
sources/extracted/

# Node modules
node_modules/
app/node_modules/

# Build output
app/dist/
app/.vite/

# Environment files
.env
.env.local
.env.production
*.env

# Supabase local
supabase/.temp/
